# 이 파일을 복사해 .env.local 을 만들고 값을 채웁니다.
# .env.local 은 git에 올라가지 않습니다.
# 값은 큰따옴표로 묶습니다.

# ---------- Supabase ----------
# 브라우저에 노출되어도 되는 값이라 NEXT_PUBLIC_ 접두사를 붙입니다.
# 주소는 프로젝트 홈에, 키는 'Project Settings > API Keys' 페이지에 있습니다.
NEXT_PUBLIC_SUPABASE_URL="https://프로젝트ID.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# ---------- Prisma ----------
# 데이터베이스 비밀번호가 들어 있으므로 절대 NEXT_PUBLIC_ 접두사를 붙이지 않습니다.
# 프로젝트 홈의 'Connect' 버튼 > 'ORM' 탭 > 'Prisma' 에서 복사하고, [YOUR-PASSWORD] 자리를 비밀번호로 바꿉니다.

# 애플리케이션이 사용하는 연결. Transaction pooler(6543)입니다.
DATABASE_URL="postgresql://postgres.프로젝트ID:비밀번호@aws-0-리전.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Prisma CLI(contract infer 등)가 사용하는 연결. Session pooler(5432)입니다.
DIRECT_URL="postgresql://postgres.프로젝트ID:비밀번호@aws-0-리전.pooler.supabase.com:5432/postgres"
